# Copy to .env.local and fill in from Supabase: Project > Connect (or Settings > API Keys).
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# Live site address, used for social-share previews (e.g. https://meli.lk).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Order confirmation emails, sent from Gmail / Google Workspace. Leave blank to skip sending.
# GMAIL_APP_PASSWORD is a 16-character App Password (Google Account > Security > 2-Step Verification > App passwords),
# not your normal Gmail password.
GMAIL_USER=
GMAIL_APP_PASSWORD=
# Optional: sender name shown in the inbox, and where customer replies go.
EMAIL_FROM_NAME=MELI
EMAIL_REPLY_TO=
